{
  "name": "documents-frontend",
  "productName": "Documents",
  "version": "1.0.0",
  "description": "Document management system frontend",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge release",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.typecheck.all.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:skip-reset": "SKIP_RESET=1 playwright test",
    "postinstall": "electron-rebuild -w smart-whisper || echo 'electron-rebuild failed for smart-whisper; local voice engine disabled until tools are available'"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
