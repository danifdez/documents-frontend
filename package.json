    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/vue": "8.1.0",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "@vitest/coverage-v8": "5.1.2",
    "@vue/test-utils": "2.6.0",
    "autoprefixer": "10.7.0",
    "electron": "45.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.16.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "playwright": "1.65.1",
    "postcss": "8.5.34",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.4.0",
